# Claude Code - Skills Shared Environment Variables
# Location: .agent/skills/.env
# Priority: Medium (overrides .agent/.env, overridden by skill-specific .env)
# Scope: Shared across all skills, higher priority than global .agent/.env
# Setup: Copy to .agent/skills/.env and configure

# ============================================
# Environment Variable Hierarchy
# ============================================
# Priority order (highest to lowest):
# 1. process.env                    - Runtime environment (HIGHEST)
# 2. .agent/skills/<skill>/.env    - Skill-specific overrides
# 3. .agent/skills/.env            - Shared across skills (this file)
# 4. .agent/.env                   - Global defaults (LOWEST)
#
# All skills use centralized resolver: ~/.claude/scripts/resolve_env.py
# Debug hierarchy: python ~/.claude/scripts/resolve_env.py --show-hierarchy --skill <skill-name>

# ============================================
# Common Skill API Keys
# ============================================
# Google Gemini API (shared by multiple skills)
# Skills using: media, library-docs, repomix
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vertex AI (Optional, for production workloads)
# GEMINI_USE_VERTEX=true
# VERTEX_PROJECT_ID=
# VERTEX_LOCATION=us-central1

# ============================================
# MCP Server Configuration
# ============================================
# Context7 MCP (Documentation search)
# Skill: library-docs, mcp
# Get your API key from https://context7.com/dashboard/api-keys
# CONTEXT7_API_KEY=

# ============================================
# Development Tools
# ============================================
# Chrome DevTools (for browser skill)
# CHROME_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# PUPPETEER_SKIP_DOWNLOAD=true

# ============================================
# Media Processing
# ============================================
# FFmpeg path (if not in PATH)
# Skill: media
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# ImageMagick path (if not in PATH)
# Skill: media
# IMAGEMAGICK_PATH=/usr/local/bin/convert

# ============================================================================
# MiniMax API Configuration (Optional - for image/video/speech/music generation)
# ============================================================================
# Get your API key: https://platform.minimax.io/user-center/basic-information/interface-key
# MINIMAX_API_KEY=

# ============================================
# Database Configuration (Shared)
# ============================================
# Common database URLs shared across skills
# DATABASE_URL=postgresql://user:pass@localhost:5432/db
# MONGODB_URI=mongodb://localhost:27017/db
# REDIS_URL=redis://localhost:6379

# ============================================
# Example Usage Scenarios
# ============================================
# Scenario 1: Global default for all skills
# .agent/.env:                            GEMINI_API_KEY=global-dev-key
# Result: All skills use global-dev-key
#
# Scenario 2: Override for all skills
# .agent/.env:                            GEMINI_API_KEY=global-dev-key
# .agent/skills/.env (this file):         GEMINI_API_KEY=skills-prod-key
# Result: All skills use skills-prod-key
#
# Scenario 3: Skill-specific override
# .agent/.env:                            GEMINI_API_KEY=global-key
# .agent/skills/.env (this file):         GEMINI_API_KEY=shared-key
# .agent/skills/media/.env:       GEMINI_API_KEY=high-quota-key
# Result: media uses high-quota-key, other skills use shared-key
#
# Scenario 4: Runtime testing
# export GEMINI_API_KEY=test-key
# Result: All skills use test-key regardless of config files
#
# Priority: runtime > skill-specific > shared (this file) > global
