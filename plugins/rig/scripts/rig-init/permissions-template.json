{
  "_comment": "Reviewed permission rules that `rig-init --permissions` merges into ~/.claude/settings.json. A plugin cannot ship permissions, so this is the only way they reach a plugin install. ask = confirm each read/edit of secrets; deny = keep the model out of dependency and build output. Rules already present are never duplicated and nothing is removed.",
  "permissions": {
    "ask": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/.env.dev)",
      "Read(**/.env.prod)",
      "Read(**/.env.stage)",
      "Read(**/.env.qa)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*credentials*.json)",
      "Read(**/secret.y*ml)",
      "Read(**/secrets.y*ml)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.next/**)",
      "Read(**/.nuxt/**)",
      "Read(**/coverage/**)"
    ]
  }
}
