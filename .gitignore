# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.coverage
coverage-ui.json

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock
pnpm-lock.yaml

# coverage
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
plans/**/*
screenshots/*
docs/screenshots/*
logs.txt
__pycache__

# Rig meta commands
prompt.md

# Agent memory (project scope)
.claude/agent-memory/

# Hook diagnostics logs
.claude/hooks/.logs/

# Session state written by hooks (per-machine runtime, never installed)
.claude/session-state/

# Gemini CLI settings (symlink to .claude/.mcp.json)
.gemini/settings.json
.claude/settings.bak.json
# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/

# demo
.claude/skills/media/assets/demo-*

# Python venvs created by skills install.sh (.claude/ and the Antigravity copy)
.claude/skills/.venv/
.agent/skills/.venv/

# Default output dir of media skill scripts (generated files)
docs/assets/
