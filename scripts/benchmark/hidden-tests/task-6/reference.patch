diff --git c/src/server/rate-limiter.ts i/src/server/rate-limiter.ts
new file mode 100644
index 0000000..7730e3e
--- /dev/null
+++ i/src/server/rate-limiter.ts
@@ -0,0 +1,41 @@
+export interface RateLimiterOptions {
+  limit: number;
+  windowMs: number;
+  now?: () => number;
+}
+
+export interface RateLimitResult {
+  allowed: boolean;
+  remaining: number;
+  retryAfterMs: number;
+}
+
+interface Window {
+  start: number;
+  count: number;
+}
+
+/** Fixed-window limiter: at most `limit` requests per key per `windowMs`. */
+export function createRateLimiter(options: RateLimiterOptions) {
+  const { limit, windowMs } = options;
+  const now = options.now ?? Date.now;
+  if (!Number.isInteger(limit) || limit < 1) throw new Error('limit must be a positive integer');
+  if (!Number.isInteger(windowMs) || windowMs < 1) throw new Error('windowMs must be a positive integer');
+  const windows = new Map<string, Window>();
+
+  return {
+    check(key: string): RateLimitResult {
+      const t = now();
+      let w = windows.get(key);
+      if (!w || t - w.start >= windowMs) {
+        w = { start: t, count: 0 };
+        windows.set(key, w);
+      }
+      if (w.count >= limit) {
+        return { allowed: false, remaining: 0, retryAfterMs: w.start + windowMs - t };
+      }
+      w.count++;
+      return { allowed: true, remaining: limit - w.count, retryAfterMs: 0 };
+    },
+  };
+}
