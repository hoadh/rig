--- /dev/null
+++ i/test/rate-limiter.test.ts
@@ -0,0 +1,12 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createRateLimiter } from '../src/server/rate-limiter.ts';
+
+test('limiter denies after the limit and recovers after the window', () => {
+  let now = 0;
+  const limiter = createRateLimiter({ limit: 1, windowMs: 100, now: () => now });
+  assert.equal(limiter.check('a').allowed, true);
+  assert.equal(limiter.check('a').allowed, false);
+  now = 100;
+  assert.equal(limiter.check('a').allowed, true);
+});
