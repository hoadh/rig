{
  "name": "rig",
  "version": "2.0.5",
  "description": "Rig — an Agentic-Driven Development toolkit for Claude Code: agents, skills, hooks and workflows that plan, build, test and review software.",
  "scripts": {
    "test": "node scripts/run-hook-tests.cjs",
    "lint": "eslint .",
    "test:eval": "bun scripts/eval/run.ts 1",
    "test:eval:e2e": "bun scripts/eval/run.ts 2 --diff",
    "test:eval:judge": "bun scripts/eval/run.ts 3 --diff",
    "test:eval:all": "bun scripts/eval/run.ts all",
    "bench": "node scripts/benchmark/run-benchmark.ts",
    "bench:verify": "node scripts/benchmark/verify-hidden-tests.ts",
    "bench:report": "node scripts/benchmark/benchmark-report.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hoadh/rig.git"
  },
  "keywords": [
    "claude-code",
    "ai-agents",
    "agentic-driven-development",
    "workflow",
    "automation",
    "cli-tools"
  ],
  "author": "Alex Dang",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hoadh/rig/issues"
  },
  "homepage": "https://github.com/hoadh/rig#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.1"
  }
}
